<?xml version="1.0"?>
<!--
  Training scene for DreamerV3 + SO-ARM101.
  - Robot mounted on top of a 1.5x1.5 m wooden table at the world origin.
  - Wrist camera attached to the gripper via the plug_camera mount mesh.
  - Overhead camera in worldbody for rendering / debug only.
  - 6 cubes + 4 pyramids (free bodies). Pose, size, colour are randomised
    in Python at reset; the geom_size / geom_rgba arrays are written into
    `mj_data` directly via the env wrapper.
-->
<mujoco model="dreamer_setup_scene">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.005" iterations="50" solver="Newton" tolerance="1e-10" cone="elliptic" impratio="10"/>
  <size memory="64M"/>

  <default>
    <default class="so101_new_calib">
      <joint damping="1" frictionloss="0.1" armature="0.005"/>
      <position kp="50"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
    <default class="sts3215">
      <geom contype="0" conaffinity="0"/>
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <!-- kp from the RBE501 DC-motor model at firmware P_gain=8 (2026-06-12, was
           998.22 at P=16; kp scales linearly with P). kv = Km*Kb/R is back-EMF
           damping only — independent of the firmware P/D registers. -->
      <position kp="499.11" kv="2.731" forcerange="-2.94 2.94"/>
    </default>
    <default class="object">
      <!-- Softer contacts: solref="0.02 1" gives a 20 ms time constant (vs 5 ms),
           and solimp lowered from 0.99/0.999 to 0.95/0.99 reduces the stiff
           contact-impulse spike that was driving QACC NaN at deep penetrations
           (especially for free-joint bodies sized ~10x smaller than before). -->
      <geom condim="4" friction="1.0 0.05 0.001" solref="0.02 1" solimp="0.9 0.95 0.001" group="1"/>
    </default>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="640" offheight="480"/>
    <map znear="0.01" zfar="6"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="300" height="300"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="2 2" texuniform="true" reflectance="0.0"/>
    <texture name="wood_tex" type="2d" builtin="flat" rgb1="0.55 0.35 0.18" width="64" height="64"/>
    <material name="wood_mat" texture="wood_tex" rgba="0.65 0.42 0.22 1" specular="0.05" shininess="0.05"/>

    <mesh file="waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="sts3215_03a_v1.stl"/>
    <mesh file="motor_holder_so101_base_v1.stl"/>
    <mesh file="wrist_roll_follower_so101_v1.stl"/>
    <mesh file="moving_jaw_so101_v1.stl"/>
    <mesh file="base_motor_holder_so101_v1.stl"/>
    <mesh file="upper_arm_so101_v1.stl"/>
    <mesh file="wrist_roll_pitch_so101_v2.stl"/>
    <mesh file="under_arm_so101_v1.stl"/>
    <mesh file="rotation_pitch_so101_v1.stl"/>
    <mesh file="motor_holder_so101_wrist_v1.stl"/>
    <mesh file="sts3215_03a_no_horn_v1.stl"/>
    <mesh file="base_so101_v2.stl"/>
    <mesh name="plug_camera" file="SO-ARM100_Plug_camera.stl" scale="0.001 0.001 0.001"/>

    <material name="robot_yellow" rgba="1 0.82 0.12 1"/>
    <material name="robot_dark"   rgba="0.10 0.10 0.10 1"/>
    <material name="cam_plug"     rgba="0.20 0.20 0.20 1"/>

    <!-- Pyramid via inline convex hull (4 base verts + 1 apex).
         Sized to fit the SO-ARM101 gripper: 4 cm base, 3 cm tall.
         Base centred on the body origin (z=0) so the body z-coordinate
         is also the resting z on the table. -->
    <mesh name="pyramid" vertex="-0.020 -0.020 0  0.020 -0.020 0  0.020 0.020 0  -0.020 0.020 0  0 0 0.030"/>
  </asset>

  <worldbody>
    <light name="spot1" pos="0.6 0.6 1.6" dir="-0.4 -0.4 -1" castshadow="false" diffuse="0.7 0.7 0.7"/>
    <light name="spot2" pos="-0.6 -0.6 1.6" dir="0.4 0.4 -1" castshadow="false" diffuse="0.5 0.5 0.5"/>

    <geom name="floor" type="plane" pos="0 0 -0.05" size="3 3 0.1" material="floor_mat"/>

    <!-- Wooden table: top surface at z=0, robot mounts at z=0. -->
    <body name="table" pos="0 0 -0.025">
      <geom name="table_top" type="box" size="1.05 0.85 0.025" material="wood_mat" friction="1.0 0.05 0.001" condim="4"/>
      <geom name="table_leg_1" type="box" pos="1.0 0.8 -0.36" size="0.03 0.03 0.36" material="wood_mat"/>
      <geom name="table_leg_2" type="box" pos="-1.0 0.8 -0.36" size="0.03 0.03 0.36" material="wood_mat"/>
      <geom name="table_leg_3" type="box" pos="1.0 -0.8 -0.36" size="0.03 0.03 0.36" material="wood_mat"/>
      <geom name="table_leg_4" type="box" pos="-1.0 -0.8 -0.36" size="0.03 0.03 0.36" material="wood_mat"/>
    </body>

    <!-- SO-ARM101 arm -->
    <body name="base" pos="0 0 0" quat="1 0 0 0" childclass="so101_new_calib">
      <inertial pos="0.0137179 -5.19711e-05 0.0334843" mass="0.147" fullinertia="0.000114686 0.000136117 0.000130364 -4.59787e-07 4.97151e-06 9.75275e-08"/>
      <geom type="mesh" class="visual" pos="-0.00636471 -9.94414e-05 -0.0024" quat="0.5 0.5 0.5 0.5" mesh="base_motor_holder_so101_v1" material="robot_yellow"/>
      <geom type="mesh" class="visual" pos="-0.00636471 -8.97657e-09 -0.0024" quat="0.5 0.5 0.5 0.5" mesh="base_so101_v2" material="robot_yellow"/>
      <geom type="mesh" class="visual" pos="0.0263353 -8.97657e-09 0.0437" quat="1 0 0 0" mesh="sts3215_03a_v1" material="robot_dark"/>
      <geom type="mesh" class="visual" pos="-0.0309827 -0.000199441 0.0474" quat="0.5 0.5 0.5 0.5" mesh="waveshare_mounting_plate_so101_v2" material="robot_yellow"/>
      <site group="3" name="baseframe" pos="0 0 0"/>

      <body name="shoulder" pos="0.0388353 -8.97657e-09 0.0624" quat="3.56167e-16 1.22818e-15 -1 -4.14635e-16">
        <joint axis="0 0 1" name="shoulder_pan" type="hinge" range="-1.9198621771937616 1.9198621771937634" class="sts3215"/>
        <inertial pos="-0.0307604 -1.66727e-05 -0.0252713" mass="0.100006" fullinertia="8.3759e-05 8.10403e-05 2.39783e-05 7.55525e-08 -1.16342e-06 1.54663e-07"/>
        <geom type="mesh" class="visual" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5" mesh="sts3215_03a_v1" material="robot_dark"/>
        <geom type="mesh" class="collision" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5" mesh="sts3215_03a_v1" material="robot_dark"/>
        <geom type="mesh" class="visual" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5" mesh="motor_holder_so101_base_v1" material="robot_yellow"/>
        <geom type="mesh" class="collision" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5" mesh="motor_holder_so101_base_v1" material="robot_yellow"/>
        <geom type="mesh" class="visual" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 -0 0" mesh="rotation_pitch_so101_v1" material="robot_yellow"/>
        <geom type="mesh" class="collision" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 -0 0" mesh="rotation_pitch_so101_v1" material="robot_yellow"/>

        <body name="upper_arm" pos="-0.0303992 -0.0182778 -0.0542" quat="0.5 -0.5 -0.5 -0.5">
          <joint axis="0 0 1" name="shoulder_lift" type="hinge" range="-1.7453292519943224 1.7453292519943366" class="sts3215"/>
          <inertial pos="-0.0898471 -0.00838224 0.0184089" mass="0.103" fullinertia="4.08002e-05 0.000147318 0.000142487 -1.97819e-05 -4.03016e-08 8.97326e-09"/>
          <geom type="mesh" class="visual" pos="-0.11257 -0.0155 0.0187" quat="0 -0.707107 0.707107 0" mesh="sts3215_03a_v1" material="robot_dark"/>
          <geom type="mesh" class="collision" pos="-0.11257 -0.0155 0.0187" quat="0 -0.707107 0.707107 0" mesh="sts3215_03a_v1" material="robot_dark"/>
          <geom type="mesh" class="visual" pos="-0.065085 0.012 0.0182" quat="0 1 0 0" mesh="upper_arm_so101_v1" material="robot_yellow"/>
          <geom type="mesh" class="collision" pos="-0.065085 0.012 0.0182" quat="0 1 0 0" mesh="upper_arm_so101_v1" material="robot_yellow"/>

          <body name="lower_arm" pos="-0.11257 -0.028 0" quat="0.707107 0 0 0.707107">
            <joint axis="0 0 1" name="elbow_flex" type="hinge" range="-1.69 1.69" class="sts3215"/>
            <inertial pos="-0.0980701 0.00324376 0.0182831" mass="0.104" fullinertia="2.87438e-05 0.000159844 0.00014529 7.41152e-06 1.26409e-06 -4.90188e-08"/>
            <geom type="mesh" class="visual" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0" mesh="under_arm_so101_v1" material="robot_yellow"/>
            <geom type="mesh" class="collision" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0" mesh="under_arm_so101_v1" material="robot_yellow"/>
            <geom type="mesh" class="visual" pos="-0.0648499 -0.032 0.018" quat="0 -1 0 0" mesh="motor_holder_so101_wrist_v1" material="robot_yellow"/>
            <geom type="mesh" class="collision" pos="-0.0648499 -0.032 0.018" quat="0 -1 0 0" mesh="motor_holder_so101_wrist_v1" material="robot_yellow"/>
            <geom type="mesh" class="visual" pos="-0.1224 0.0052 0.0187" quat="0 0 1 0" mesh="sts3215_03a_v1" material="robot_dark"/>
            <geom type="mesh" class="collision" pos="-0.1224 0.0052 0.0187" quat="0 0 1 0" mesh="sts3215_03a_v1" material="robot_dark"/>

            <body name="wrist" pos="-0.1349 0.0052 0" quat="0.707107 0 0 -0.707107">
              <joint axis="0 0 1" name="wrist_flex" type="hinge" range="-1.6580628494556928 1.6580627293335335" class="sts3215"/>
              <inertial pos="-0.000103312 -0.0386143 0.0281156" mass="0.079" fullinertia="3.68263e-05 2.5391e-05 2.1e-05 1.7893e-08 -5.28128e-08 3.6412e-06"/>
              <geom type="mesh" class="visual" pos="0 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5" mesh="sts3215_03a_no_horn_v1" material="robot_dark"/>
              <geom type="mesh" class="collision" pos="0 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5" mesh="sts3215_03a_no_horn_v1" material="robot_dark"/>
              <geom type="mesh" class="visual" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5" mesh="wrist_roll_pitch_so101_v2" material="robot_yellow"/>
              <geom type="mesh" class="collision" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5" mesh="wrist_roll_pitch_so101_v2" material="robot_yellow"/>

              <body name="gripper" pos="0 -0.0611 0.0181" quat="0.0172091 -0.0172091 0.706897 0.706897">
                <joint axis="0 0 1" name="wrist_roll" type="hinge" range="-2.7438472969992493 2.841206309382605" class="sts3215"/>
                <inertial pos="0.000213627 0.000245138 -0.025187" mass="0.087" fullinertia="2.75087e-05 4.33657e-05 3.45059e-05 -3.35241e-07 -5.7352e-06 -5.17847e-08"/>
                <geom type="mesh" class="visual" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0" mesh="sts3215_03a_v1" material="robot_dark"/>
                <geom type="mesh" class="collision" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0" mesh="sts3215_03a_v1" material="robot_dark"/>
                <geom type="mesh" class="visual" pos="0 0 0.001" quat="0 1 0 0" mesh="wrist_roll_follower_so101_v1" material="robot_yellow"/>
                <geom type="mesh" class="collision" pos="0 0 0.001" quat="0 1 0 0" mesh="wrist_roll_follower_so101_v1" material="robot_yellow"/>
                <site group="3" name="gripperframe" pos="-0.0079 0 -0.0981274" quat="0.707107 0 0.707107 0"/>

                <!-- Wrist camera, mounted on the plug_camera bracket: +y side of gripper, slightly above and forward of the fingertips, angled forward+down. -->
                <body name="plug_camera_mount" pos="0.05 0.06 -0.04" euler="0 0 0">
                  <geom type="mesh" mesh="plug_camera" material="cam_plug" contype="0" conaffinity="0" group="2"/>
                  <camera name="wrist_cam" pos="0 0 0" euler="-0.233 1.012 0" fovy="70"/>
                </body>

                <body name="moving_jaw_so101_v1" pos="0.0202 0.0188 -0.0234" quat="0.707107 0.707107 0 0">
                  <joint axis="0 0 1" name="gripper" type="hinge" range="-0.17453297762778586 1.7453291995659765" class="sts3215"/>
                  <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012" fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                  <geom type="mesh" class="visual" pos="0 0 0.0189" quat="1 0 0 0" mesh="moving_jaw_so101_v1" material="robot_yellow"/>
                  <geom type="mesh" class="collision" pos="0 0 0.0189" quat="1 0 0 0" mesh="moving_jaw_so101_v1" material="robot_yellow"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Object soup: 6 cubes + 4 pyramids. Pose, cube-size, and colour are
         randomised in Python at reset. Default half-size is 0.018 (3.6 cm
         cube), graspable by the SO-ARM101 gripper. Default cube z=0.018 puts
         the cube resting on the table top (z=0). Pyramids sit at z=0 because
         their mesh base is at the body origin (see asset def). -->
    <body name="object_0" pos="0.22  0.00 0.018">
      <freejoint name="object_0_free"/>
      <geom name="object_0" class="object" type="box" size="0.018 0.018 0.018" rgba="0.9 0.1 0.1 1" mass="0.025"/>
    </body>
    <body name="object_1" pos="0.16  0.12 0.018">
      <freejoint name="object_1_free"/>
      <geom name="object_1" class="object" type="box" size="0.018 0.018 0.018" rgba="0.1 0.9 0.1 1" mass="0.025"/>
    </body>
    <body name="object_2" pos="0.16 -0.12 0.018">
      <freejoint name="object_2_free"/>
      <geom name="object_2" class="object" type="box" size="0.018 0.018 0.018" rgba="0.1 0.1 0.9 1" mass="0.025"/>
    </body>
    <body name="object_3" pos="0.30  0.10 0.018">
      <freejoint name="object_3_free"/>
      <geom name="object_3" class="object" type="box" size="0.018 0.018 0.018" rgba="0.9 0.9 0.1 1" mass="0.025"/>
    </body>
    <body name="object_4" pos="0.30 -0.10 0.018">
      <freejoint name="object_4_free"/>
      <geom name="object_4" class="object" type="box" size="0.018 0.018 0.018" rgba="0.9 0.1 0.9 1" mass="0.025"/>
    </body>
    <body name="object_5" pos="0.36  0.00 0.018">
      <freejoint name="object_5_free"/>
      <geom name="object_5" class="object" type="box" size="0.018 0.018 0.018" rgba="0.1 0.9 0.9 1" mass="0.025"/>
    </body>
    <body name="object_6" pos="0.20  0.20 0.001">
      <freejoint name="object_6_free"/>
      <geom name="object_6" class="object" type="mesh" mesh="pyramid" rgba="0.95 0.55 0.10 1" mass="0.025"/>
    </body>
    <body name="object_7" pos="0.20 -0.20 0.001">
      <freejoint name="object_7_free"/>
      <geom name="object_7" class="object" type="mesh" mesh="pyramid" rgba="0.30 0.30 0.30 1" mass="0.025"/>
    </body>
    <body name="object_8" pos="0.34  0.18 0.001">
      <freejoint name="object_8_free"/>
      <geom name="object_8" class="object" type="mesh" mesh="pyramid" rgba="0.50 0.20 0.80 1" mass="0.025"/>
    </body>
    <body name="object_9" pos="0.34 -0.18 0.001">
      <freejoint name="object_9_free"/>
      <geom name="object_9" class="object" type="mesh" mesh="pyramid" rgba="0.95 0.95 0.95 1" mass="0.025"/>
    </body>

    <!-- Overhead camera (security-cam in corner of table, slightly above robot base, angled inward+down). -->
    <camera name="overhead" pos="0.85 0.85 0.40" xyaxes="-0.7071 0.7071 0  -0.198 -0.198 0.960" fovy="75"/>
  </worldbody>

  <actuator>
    <position class="sts3215" name="shoulder_pan"  joint="shoulder_pan"  forcerange="-3.35 3.35" ctrlrange="-1.91986 1.91986"/>
    <position class="sts3215" name="shoulder_lift" joint="shoulder_lift" forcerange="-3.35 3.35" ctrlrange="-1.74533 1.74533"/>
    <position class="sts3215" name="elbow_flex"   joint="elbow_flex"    forcerange="-3.35 3.35" ctrlrange="-1.69 1.69"/>
    <position class="sts3215" name="wrist_flex"   joint="wrist_flex"    forcerange="-3.35 3.35" ctrlrange="-1.65806 1.65806"/>
    <position class="sts3215" name="wrist_roll"   joint="wrist_roll"    forcerange="-3.35 3.35" ctrlrange="-2.74385 2.84121"/>
    <position class="sts3215" name="gripper"      joint="gripper"       forcerange="-3.35 3.35" ctrlrange="-0.17453 1.74533"/>
  </actuator>
</mujoco>
